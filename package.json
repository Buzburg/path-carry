{
  "name": "path-carry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catch troublesome filenames before a folder or ZIP changes hands. Offline, read-only, no account.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {"@zip.js/zip.js": "2.23.0"},
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.15",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "overrides": {"playwright-core": "1.58.2"}
}
